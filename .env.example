# Server
APP_NAME=ebay-cross-border-intelligence
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# eBay production application credentials (keep secret)
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional live web/supplier search
TAVILY_API_KEY=

# Optional security for a public deployment
MCP_AUTH_TOKEN=

# HTTP timeouts
HTTP_TIMEOUT_SECONDS=20
MAX_EVIDENCE_CHARS=6000
